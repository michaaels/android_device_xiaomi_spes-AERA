#
# USB for spes (SM6225, dwc3 controller 4e00000.dwc3).
#
# bootable/recovery/etc/init.rc already owns the configfs gadget: it creates
# g1 with ffs.adb/ffs.fastboot, mounts their functionfs instances and binds
# the UDC for sys.usb.config=adb|sideload|fastboot. This file must NOT handle
# those states again: a second handler unlinking/relinking functions and
# rewriting UDC made both handlers re-fire on every adbd restart, leaving the
# gadget unbound (UDC empty) and init busy (observed on hardware,
# docs/evidence/pstore-aera-diag). Here we only:
#   - select the configfs path, and
#   - add the MTP function, which the base init.rc does not provide.

on init
    # Must be 1 before "fs" so init.rc's "on fs && sys.usb.configfs=1" runs.
    setprop sys.usb.configfs 1

on fs
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp uid=1024,gid=1024,rmode=0770,fmode=0660,no_disconnect=1
    setprop sys.usb.mtp.device_type 3

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}

# init.rc removes f1 for "none"; also drop the second function used by mtp,adb.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

# Bind only once both functionfs instances have their descriptors:
# adbd sets sys.usb.ffs.ready, AERA's MTP server sets sys.usb.ffs.mtp.ready.
on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1 && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp && property:sys.usb.configfs=1 && property:sys.usb.ffs.mtp.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idProduct 0x4EE1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
