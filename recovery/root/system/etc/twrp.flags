# Extra recovery partition definitions for spes / spesn.
# mount point     fstype  device                                    device2                flags

# Metadata (encryption keys for userdata)
/metadata         ext4    /dev/block/bootdevice/by-name/metadata                           flags=display="Metadata";backup=1;wrappedkey

# Boot chain (A/B). spes has no recovery partition: AERA lives in boot.
/boot             emmc    /dev/block/bootdevice/by-name/boot                               flags=display="Boot";backup=1;flashimg=1;slotselect
/vendor_boot      emmc    /dev/block/bootdevice/by-name/vendor_boot                        flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/dtbo             emmc    /dev/block/bootdevice/by-name/dtbo                               flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta           emmc    /dev/block/bootdevice/by-name/vbmeta                             flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system    emmc    /dev/block/bootdevice/by-name/vbmeta_system                      flags=display="VBMeta System";backup=1;flashimg=1;slotselect

# Persist (calibration data). Mounted read-only: AERA (from OrangeFox) would
# otherwise save /persist/.aera and /persist/.fsec on every settings save,
# mounting it read-write (observed on hardware). Settings live in
# /data/recovery instead (AERA_SETTINGS_ROOT_DIRECTORY in vendorsetup.sh).
# Raw backup/restore of the partition uses /persist_image and is unaffected.
/persist          ext4    /dev/block/bootdevice/by-name/persist                            flags=display="Persist";fsflags="ro"
/persist_image    emmc    /dev/block/bootdevice/by-name/persist                            flags=display="Persist Image";backup=1;flashimg=1

# Firmware (read-only mounts as in the stock fstab)
/firmware         vfat    /dev/block/bootdevice/by-name/modem                              flags=display="Firmware";slotselect;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337"
/modem            emmc    /dev/block/bootdevice/by-name/modem                              flags=display="Modem";backup=1;slotselect
/bluetooth        emmc    /dev/block/bootdevice/by-name/bluetooth                          flags=backup=1;subpartitionof=/modem;slotselect
/dsp              emmc    /dev/block/bootdevice/by-name/dsp                                flags=backup=1;subpartitionof=/modem;slotselect

# EFS / modem NV (IMEI). Backup strongly recommended before any flashing.
/efs1             emmc    /dev/block/bootdevice/by-name/modemst1                           flags=display="EFS";backup=1
/efs2             emmc    /dev/block/bootdevice/by-name/modemst2                           flags=backup=1;subpartitionof=/efs1
/efsc             emmc    /dev/block/bootdevice/by-name/fsc                                flags=backup=1;subpartitionof=/efs1
/efsg             emmc    /dev/block/bootdevice/by-name/fsg                                flags=backup=1;subpartitionof=/efs1

# Removable storage (microSD slot on 4784000.sdhci, USB OTG)
/external_sd      auto    /dev/block/mmcblk0p1                      /dev/block/mmcblk0     flags=display="MicroSD";storage;wipeingui;removable
/usb_otg          auto    /dev/block/sdg1                           /dev/block/sdg         flags=display="USB OTG";storage;wipeingui;removable
