#
# Recovery init for spes / spesn (ro.hardware=qcom).

import /init.recovery.qcom_decrypt.rc
import /init.recovery.wifi.rc
# /init.recovery.usb.rc is imported by bootable/recovery/etc/init.rc

# Sets spes / spesn product props from the hardware SKU
service variant-script /system/bin/variant-script.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Flashlight: AERA_FL_PATH1=/tmp/spes-torch -> TLMM GPIO85 (torch mode)
service spes-torch-setup /system/bin/spes-torch-setup.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system

on post-fs
    # Installed vendor ships android.hardware.boot@1.2 (QTI impl bundled under /vendor/lib64/hw)
    start boot-hal-1-2

on boot
    start health-hal-2-1
    # GPU for sandboxed AERA plugins (Browser): the worker runs as UID 99090.
    # Stock ueventd gives kgsl-3d0 0666; on this pre-DMA-heap 4.19 kernel
    # Turnip allocates through ION, so the worker also needs it read-write.
    chmod 0666 /dev/kgsl-3d0
    chmod 0666 /dev/ion
    start variant-script
    start spes-torch-setup
    setprop sys.usb.config adb
